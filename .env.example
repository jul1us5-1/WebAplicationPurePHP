# Copia este archivo como .env y rellena tus propios valores.
# El archivo .env NUNCA se debe subir a GitHub (ya está en .gitignore).

# --- Base de datos ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=servissana_db

# --- Google reCAPTCHA (clave SECRETA del servidor) ---
RECAPTCHA_SECRET=tu_clave_secreta_de_recaptcha

# --- Correo (PHPMailer / SMTP de Gmail) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
MAIL_FROM=tu-correo@gmail.com
MAIL_FROM_NAME=Servissana
